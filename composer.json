{
    "name": "jeffersongoncalves/laravel-hubspot",
    "description": "PHP/Laravel client for the HubSpot CRM REST API: contacts, companies, deals, tickets, associations, and search.",
    "keywords": [
        "laravel",
        "laravel-hubspot"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-hubspot",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "email": "gerson.simao.92@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jeffersongoncalves\\Hubspot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jeffersongoncalves\\Hubspot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jeffersongoncalves\\Hubspot\\HubspotServiceProvider"
            ],
            "aliases": {
                "Hubspot": "Jeffersongoncalves\\Hubspot\\Facades\\Hubspot"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
